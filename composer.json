{
  "name" : "vrajroham/laravel-bitpay",
  "description" : "BitPay wrapper for laravel",
  "keywords" : [
    "bitpay",
    "BTC",
    "laravel",
    "crypto",
    "payments"
  ],
  "homepage" : "https://github.com/vrajroham/laravel-bitpay",
  "license" : "MIT",
  "authors" : [
    {
      "name" : "Vaibhavraj Roham",
      "email" : "vaibhavraj@vrajroham.me",
      "homepage" : "https://vrajroham.me",
      "role" : "Creator"
    },
    {
      "name" : "Alex Stewart",
      "email" : "laravelbitpay@alexstewartja.com",
      "homepage" : "https://github.com/alexstewartja",
      "role" : "Maintainer"
    }
  ],
  "repositories" : [
    {
      "type" : "vcs",
      "url" : "https://github.com/alexstewartja/php-bitpay-client-v2.git"
    }
  ],
  "require" : {
    "php" : "^8.1 || ^8.2 || ^8.3 || ^8.4",
    "ext-json" : "*",
    "ext-reflection" : "*",
    "bitpay/sdk": "dev-subscriptions"
  },
  "require-dev" : {
    "phpunit/phpunit": ">=9.5"
  },
  "autoload" : {
    "psr-4" : {
      "Vrajroham\\LaravelBitpay\\" : "src"
    }
  },
  "autoload-dev" : {
    "psr-4" : {
      "Vrajroham\\LaravelBitpay\\Tests\\" : "tests\\Vrajroham\\LaravelBitpay\\Tests"
    }
  },
  "scripts" : {
    "test" : "vendor/bin/phpunit",
    "test-coverage" : "vendor/bin/phpunit --coverage-html coverage"
  },
  "config" : {
    "sort-packages" : true
  },
  "extra" : {
    "laravel" : {
      "providers" : [
        "Vrajroham\\LaravelBitpay\\LaravelBitpayServiceProvider"
      ],
      "aliases" : {
        "LaravelBitpay" : "Vrajroham\\LaravelBitpay\\LaravelBitpay"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
